# Arch Linux package for OpenTartarus, built from the checkout this file
# sits in. From packaging/arch, run:  makepkg -si
pkgname=opentartarus
pkgver=0.2.0
pkgrel=1
pkgdesc="Razer Tartarus V2, Pro and V2 Pro keypad profiles and remaps for Linux"
arch=('x86_64')
url="https://github.com/PikkonMG/opentartarus"
license=('MIT')
depends=('gcc-libs' 'glibc' 'udev' 'polkit' 'libxkbcommon' 'wayland')
makedepends=('cargo')
optdepends=('openrazer-daemon: keypad lighting'
            'libx11: the window on an X11 session'
            'libxcursor: the window on an X11 session')
install=opentartarus.install
options=('!lto' '!debug')

_repo() {
  realpath "$startdir/../.."
}

build() {
  cd "$(_repo)"
  export RUSTUP_TOOLCHAIN=stable
  cargo build --release --locked --workspace
}

package() {
  cd "$(_repo)"
  install -Dm755 target/release/opentartarus-daemon "$pkgdir/usr/bin/opentartarus-daemon"
  install -Dm755 target/release/opentartarus-ui "$pkgdir/usr/bin/opentartarus-ui"
  install -Dm755 target/release/opentartarus-fix-permissions "$pkgdir/usr/libexec/opentartarus-fix-permissions"
  install -Dm644 packaging/udev/70-opentartarus.rules "$pkgdir/usr/lib/udev/rules.d/70-opentartarus.rules"
  install -Dm644 packaging/polkit/com.opentartarus.fix-permissions.policy "$pkgdir/usr/share/polkit-1/actions/com.opentartarus.fix-permissions.policy"
  install -Dm644 packaging/desktop/opentartarus.desktop "$pkgdir/usr/share/applications/opentartarus.desktop"
  install -Dm644 packaging/autostart/opentartarus-daemon.desktop "$pkgdir/etc/xdg/autostart/opentartarus-daemon.desktop"
  install -Dm644 packaging/systemd/opentartarus-daemon.service "$pkgdir/usr/lib/systemd/user/opentartarus-daemon.service"
  install -Dm644 packaging/icons/opentartarus.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/opentartarus.svg"
  install -Dm644 README.md "$pkgdir/usr/share/doc/opentartarus/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/opentartarus/LICENSE"
}
